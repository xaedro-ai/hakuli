{
  "method": "hakuli",
  "model": "models/llama-7b",
  "dataset": "c4",
  "batch_size": 16,
  "seq_len": 256,
  "steps": 150,
  "warmup_steps": 10,
  "lr": 1e-05,
  "rank": 512,
  "scale": 1.0,
  "update_proj_gap": 200,
  "spike_every": 25,
  "spike_factor": 50.0,
  "optimizer_kwargs": {"anti_windup": true},
  "seed": 0,
  "eval_batches": 8,
  "eval_every": 50,
  "print_every": 10,
  "output": "benchmarks/results/short_llama7b_antiwindup.json",
  "log_jsonl": "benchmarks/results/short_llama7b_antiwindup.jsonl"
}
